(function () {
  var $  = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  var track = $('[data-track]'), stage = $('[data-stage]'), video = $('[data-video]'),
      plate = $('[data-plate]'), scrim = $('[data-scrim]'), mark = $('[data-mark]'),
      column = $('[data-column]'), copy = $('[data-copy]'), lead = $('[data-lead]'),
      title = $('[data-title]'), ctaRow = $('[data-cta]'), cards = $('[data-cards]'),
      rail = $('[data-rail]'), stageLabel = $('[data-stagelabel]'), percent = $('[data-percent]'),
      bar = $('[data-bar]'), hint = $('[data-hint]'), nav = $('#nav'), footerRow = $('[data-footerrow]');
  var cardEls = $$('[data-card]'), fillEls = $$('[data-fill]'), tickEls = $$('[data-tick]');

  if (!track) return;

  var stages = [
    [0.00, "Cezve ısınıyor"], [0.13, "Çekirdek öğütüldü"], [0.26, "Su ekleniyor"],
    [0.39, "Köpük kabarıyor"], [0.52, "Dökülüyor"], [0.65, "Fincan doluyor"],
    [0.80, "Köpük oturuyor"], [0.92, "Kıvamında"]
  ];

  var raf = 0, target = 0, current = 0, wantT = null;
  var isMobile = window.innerWidth < 760;
  var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (video) { video.muted = true; video.pause(); }

  function tick() {
    raf = 0;
    var diff = target - current;
    current += Math.abs(diff) < 0.0008 ? diff : diff * 0.34;
    paint(current);
    if (video && video.duration && !reduced && !isMobile) {
      var end = video.duration - 0.04;
      var t = current * end;
      wantT = t;
      if (!video.seeking && Math.abs(video.currentTime - t) > 0.012) { try { video.currentTime = t; } catch (e) {} }
    }
    var seekPending = video && wantT != null && Math.abs(video.currentTime - wantT) > 0.012;
    if (Math.abs(target - current) > 0.0008 || seekPending) raf = window.requestAnimationFrame(tick);
  }

  function onScroll() {
    if (!track) return;
    var total = track.offsetHeight - window.innerHeight;
    target = total > 0 ? Math.min(1, Math.max(0, -track.getBoundingClientRect().top / total)) : 0;
    if (!raf) raf = window.requestAnimationFrame(tick);
  }

  function onResize() { layout(); onScroll(); }

  function mobile() {
    var w = window.innerWidth, m = w < 760;
    isMobile = m;
    var mediaH = "clamp(230px,40vh,400px)";
    [video, plate].forEach(function (el) {
      if (!el) return;
      el.style.width = m ? "calc(100% - 28px)" : "58%";
      el.style.height = m ? mediaH : "100%";
      el.style.top = m ? "14px" : "0";
      el.style.right = m ? "14px" : "0";
      el.style.borderRadius = m ? "var(--radius-tile)" : "var(--radius-arch) 0 0 0";
      el.style.objectPosition = "center";
    });
    if (video) {
      video.loop = m;
      video.style.opacity = 1;
      if (m && !reduced) { if (video.paused) { try { video.currentTime = 0; video.play(); } catch (e) {} } }
      else if (!video.paused) video.pause();
    }
    if (track) track.style.height = m ? "auto" : "720vh";
    if (stage) { stage.style.position = m ? "relative" : "sticky"; stage.style.height = m ? "auto" : "100vh"; stage.style.minHeight = m ? "100svh" : ""; }
    if (scrim) {
      scrim.style.display = m ? "none" : "block";
      scrim.style.background = m ? "none" : "linear-gradient(100deg,var(--cream-200) 0%,var(--cream-200) 34%,rgba(247,237,222,.72) 42%,rgba(247,237,222,0) 52%)";
    }
    if (mark) { mark.style.display = m ? "flex" : "none"; mark.style.top = "32px"; }
    if (hint) hint.style.display = m ? "none" : "flex";
    if (bar && bar.parentElement) bar.parentElement.style.display = m ? "none" : "block";
    if (nav) nav.style.display = m ? "none" : "flex";
    if (rail) rail.style.display = m ? "none" : "flex";
    if (column) {
      column.style.justifyContent = m ? "flex-start" : "space-between";
      column.style.paddingTop = m ? "calc(" + mediaH + " + 32px)" : "clamp(24px,8vh,120px)";
