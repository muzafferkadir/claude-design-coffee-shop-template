<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kıvam Kahve — Karaköy</title>
<meta name="description" content="Kıvam Kahve — Karaköy'de üçüncü nesil kahve evi. Tek kökenli çekirdekler, közde demleme. Her gün 08.00 – 23.00.">
<meta property="og:title" content="Kıvam Kahve — Kıvamında bir fincan.">
<meta property="og:description" content="Tek kökenli çekirdekleri közde, sabırla demliyoruz. Karaköy, İstanbul.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/video/kivam-pour-poster.jpg">
<meta name="theme-color" content="#F7EDDE">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,300..800;1,300..800&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ===== Kıvam design tokens ===================================== */
:root{
/* fonts */
--font-display:"Petrona",Georgia,"Times New Roman",serif;
--font-body:"DM Sans","Helvetica Neue",Arial,sans-serif;
--font-mono:"DM Mono",ui-monospace,SFMono-Regular,monospace;
/* warm neutrals */
--cream-50:#FFFCF6;--cream-100:#FAF3E7;--cream-200:#F7EDDE;--cream-300:#EFE2CD;--cream-400:#E3D2B8;
/* ink */
--ink-900:#221F13;--ink-800:#2A2617;--ink-700:#3A3524;--ink-500:#6B6450;--ink-300:#9A9382;
/* terracotta / kiremit */
--terracotta-700:#9E3D1F;--terracotta-600:#C0512C;--terracotta-500:#CF6238;--terracotta-300:#E1906B;--terracotta-100:#F4D6C5;
/* clay & peach */
--clay-500:#D9744A;--peach-300:#E9A583;--peach-100:#F6DCC9;
/* mustard / hardal */
--mustard-600:#D69A23;--mustard-500:#E9B23C;--mustard-300:#F2CE7C;--mustard-100:#FAECC8;
/* lavender / grape */
--lavender-200:#DCD2EE;--lavender-300:#C8B8E3;--lavender-400:#AC96D4;--grape-500:#8E72C7;--grape-700:#6B4FA3;
/* olive */
--olive-600:#4A5232;--olive-500:#5B6337;--olive-300:#8D9463;
/* photo-matched blocks */
--photo-olive:#4D4D29;--photo-terracotta:#C74718;--photo-mustard:#F7B32A;
/* semantic surfaces */
--surface-page:var(--cream-200);--surface-card:var(--cream-50);--surface-warm:var(--terracotta-600);
/* semantic text */
--text-body:var(--ink-800);--text-heading:var(--ink-900);--text-muted:var(--ink-500);
--text-eyebrow:var(--terracotta-600);--text-link:var(--terracotta-600);--text-link-hover:var(--terracotta-700);
/* lines & actions */
--border-hairline:rgba(34,31,19,.14);--border-strong:var(--ink-800);
--action-primary:var(--terracotta-600);--action-primary-hover:var(--terracotta-700);--action-primary-text:var(--cream-50);
/* type scale */
--fs-eyebrow:12px;--fs-body-sm:14px;--fs-caption:13px;--fs-micro:11px;
--fw-body-medium:500;--fw-body-bold:700;
--tracking-eyebrow:0.14em;--tracking-button:0.08em;
/* spacing */
--space-2:8px;--space-3:12px;--space-4:16px;
/* radii */
--radius-sm:8px;--radius-md:14px;--radius-lg:20px;--radius-pill:999px;--radius-arch:220px;
--radius-button:var(--radius-sm);--radius-tile:var(--radius-lg);
/* shadows */
--shadow-card:0 1px 2px rgba(34,31,19,.05);--shadow-lift:0 8px 24px -12px rgba(34,31,19,.22);
/* motion */
--ease-out-soft:cubic-bezier(.22,.61,.36,1);--dur-fast:120ms;--dur-base:200ms;--press-scale:0.97;
--focus-ring:var(--grape-500);
}

/* ===== base ==================================================== */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--surface-page);color:var(--text-body);
  font:400 16px/1.55 var(--font-body);-webkit-font-smoothing:antialiased;text-wrap:pretty;overflow-x:hidden}
h1,h2,h3{font-family:var(--font-display);color:var(--text-heading);letter-spacing:-.02em;line-height:.98;font-weight:800;margin:0}
p{margin:0}
a{color:var(--text-link);text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{color:var(--text-link-hover)}
:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
img{max-width:100%}
section[id]{scroll-margin-top:16px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

/* ===== components ============================================= */
/* Logotype */
.logo{display:inline-flex;flex-direction:column;align-items:center;gap:6px;color:var(--ink-900)}
.logo--cream{color:var(--cream-100)}
.logo__name{font-family:var(--font-display);font-weight:800;font-size:30px;line-height:.92;letter-spacing:.01em}
.logo__tag{display:flex;align-items:center;gap:8px;font-family:var(--font-body);font-size:9px;letter-spacing:.2em;font-weight:500}
.logo__tag::before,.logo__tag::after{content:"";width:14px;height:1px;background:currentColor;opacity:.6}

/* Eyebrow */
.eyebrow{display:block;font-family:var(--font-body);font-size:var(--fs-eyebrow);font-weight:var(--fw-body-bold);
  letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-eyebrow)}
.eyebrow--cream{color:var(--cream-200)}
.eyebrow--ink{color:var(--ink-500)}

/* Badge */
.badge{display:inline-flex;align-items:center;gap:var(--space-2);padding:6px 12px;border-radius:var(--radius-pill);
  font-family:var(--font-body);font-size:var(--fs-micro);font-weight:var(--fw-body-medium);
  letter-spacing:var(--tracking-eyebrow);text-transform:uppercase}
.badge--chip{padding:8px 12px;border-radius:var(--radius-sm)}
.badge--cream{background:var(--cream-50);color:var(--ink-800)}
.badge--mustard{background:var(--mustard-500);color:var(--ink-900)}
.badge--lavender{background:var(--lavender-300);color:var(--ink-900)}

/* Button */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-3);
  font-family:var(--font-body);font-weight:var(--fw-body-medium);letter-spacing:var(--tracking-button);
  text-transform:uppercase;text-decoration:none;cursor:pointer;border-radius:var(--radius-button);
  padding:14px 22px;font-size:var(--fs-caption);border:1px solid transparent;
  transition:color var(--dur-fast) var(--ease-out-soft),background-color var(--dur-fast) var(--ease-out-soft),transform var(--dur-base) var(--ease-out-soft)}
.btn--lg{padding:18px 28px;font-size:var(--fs-body-sm)}
.btn--primary{background:var(--action-primary);color:var(--action-primary-text)}
.btn--primary:hover{background:var(--action-primary-hover);color:var(--action-primary-text)}
.btn--outline{background:transparent;color:var(--ink-800);border-color:var(--border-strong)}
.btn--outline:hover{background:var(--cream-300);color:var(--ink-800)}
.btn:active{transform:scale(var(--press-scale))}
.btn__ic{width:16px;height:16px;flex:0 0 auto;display:inline-flex}
.btn__ic svg{width:100%;height:100%}
.btn--arrow:hover .btn__ic--r{transform:translateX(3px)}
.btn__ic--r{transition:transform var(--dur-base) var(--ease-out-soft)}

/* PhotoPanel */
.photo{position:relative;overflow:hidden;background:var(--cream-300)}
.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
.photo__ph{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-mono);
  font-size:var(--fs-caption);letter-spacing:.12em;text-transform:uppercase;color:rgba(34,31,19,.5)}

/* menu tile media with graceful placeholder */
.tile-media{position:relative;aspect-ratio:1/1;display:block}
.tile-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;z-index:1}
.tile-media__ph{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-mono);
  font-size:var(--fs-micro);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,252,246,.7)}
.tile-media--dark .tile-media__ph{color:rgba(34,31,19,.5)}

.band{height:clamp(180px,22vw,280px);overflow:hidden;position:relative;background:var(--cream-300)}
.band img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
.band__ph{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-mono);
  font-size:var(--fs-caption);letter-spacing:.12em;text-transform:uppercase;color:rgba(34,31,19,.5)}
</style>
</head>
<body>
<div style="background:var(--surface-page);font-family:var(--font-body);color:var(--text-body)">

<!-- ===== NAV ===== -->
<nav id="nav" style="display:flex;align-items:center;justify-content:space-between;gap:32px;padding:24px clamp(20px,5vw,64px)">
  <ul style="display:flex;gap:32px;list-style:none;margin:0;padding:0;flex:1">
    <li><a href="#menu" style="font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--terracotta-600);text-decoration:none;border-bottom:1.5px solid var(--terracotta-600);padding-bottom:3px">Menü</a></li>
    <li><a href="#surec" style="font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-800);text-decoration:none">Süreç</a></li>
    <li><a href="#hakkimizda" style="font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-800);text-decoration:none">Hakkımızda</a></li>
    <li><a href="#konum" style="font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-800);text-decoration:none">Konum</a></li>
