  <span class="logo"><span class="logo__name">KIVAM</span><span class="logo__tag">KARAKÖY</span></span>
  <div style="flex:1;display:flex;justify-content:flex-end;align-items:center;gap:24px">
    <span style="font-family:var(--font-mono);font-size:12px;color:var(--ink-500)">08.00 – 23.00</span>
    <a href="https://instagram.com/kivamkahve" target="_blank" rel="noopener" style="font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-800);text-decoration:none">@kivamkahve</a>
  </div>
</nav>

<!-- ===== HERO (scroll-scrub) ===== -->
<section id="surec" style="position:relative;height:720vh" data-track>
<div data-stage style="position:sticky;top:0;height:100vh;overflow:hidden">
  <div data-plate style="position:absolute;top:0;right:0;width:58%;height:100%;background:var(--cream-300);border-radius:var(--radius-arch) 0 0 0"></div>
  <video data-video src="assets/video/kivam-pour-2.mp4" poster="assets/video/kivam-pour-poster.jpg" muted playsinline preload="auto" style="position:absolute;top:0;right:0;width:58%;height:100%;object-fit:cover;border-radius:var(--radius-arch) 0 0 0;background:var(--cream-300);opacity:0;transition:opacity 600ms var(--ease-out-soft)"></video>
  <div data-scrim style="position:absolute;inset:0;background:linear-gradient(100deg,var(--cream-200) 0%,var(--cream-200) 34%,rgba(247,237,222,.72) 42%,rgba(247,237,222,0) 52%)"></div>
  <div data-mark style="display:none;position:absolute;top:20px;left:0;right:0;z-index:4;justify-content:center;pointer-events:none">
    <div style="background:var(--cream-50);border-radius:999px;padding:10px 26px;box-shadow:var(--shadow-card)">
      <span class="logo"><span class="logo__name">KIVAM</span><span class="logo__tag">KARAKÖY</span></span>
    </div>
  </div>
  <div data-column style="position:relative;z-index:3;height:100%;display:flex;flex-direction:column;justify-content:space-between;gap:24px;padding:clamp(24px,8vh,120px) clamp(20px,5vw,64px) 46px;min-height:0;pointer-events:none">
    <div data-copy style="display:flex;flex-direction:column;gap:22px;max-width:min(46vw,560px);pointer-events:auto;min-height:0">
      <span class="eyebrow">Kıvam Kahve</span>
      <div style="display:flex"><span class="badge badge--cream" style="transform:rotate(-2deg)">Her gün 08.00 – 23.00 · Karaköy</span></div>
      <div>
        <h1 data-title style="font-family:var(--font-display);font-weight:800;font-size:clamp(38px,min(5.6vw,8.4vh),82px);line-height:.98;letter-spacing:-.02em;color:var(--ink-900);max-width:11ch;margin:0">Kıvamında bir fincan.</h1>
        <svg width="164" height="16.4" viewBox="0 0 120 12" preserveAspectRatio="none" fill="none" style="display:block;overflow:visible;margin-top:20px"><path d="M2 8C10 2.5 16 2.5 24 7.5S38 12 46 7 60 1.5 68 6.5 82 11.5 90 6.5 104 1.5 118 7" stroke="var(--lavender-400)" stroke-width="2.5" stroke-linecap="round"/></svg>
      </div>
      <p data-lead style="font-size:18px;line-height:1.55;max-width:32ch;color:var(--ink-800);margin:0">Tek kökenli çekirdekleri közde, sabırla demliyoruz. Acelesi olmayan bir kahve deneyimi.</p>
      <div data-cta style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
        <a href="#menu" class="btn btn--lg btn--primary btn--arrow">Menüyü gör<span class="btn__ic btn__ic--r"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></a>
        <a href="#konum" class="btn btn--lg btn--outline"><span class="btn__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>Yol tarifi</a>
      </div>
    </div>
    <div data-cards style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;pointer-events:auto;flex:0 0 auto">
      <div data-card style="display:flex;flex-direction:column;gap:8px;transition:opacity 320ms var(--ease-out-soft),transform 320ms var(--ease-out-soft);opacity:0;transform:translateY(22px)"><div style="display:flex;flex-direction:column;gap:8px;background:var(--cream-50);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-card);flex:1">
        <span style="font-family:var(--font-display);font-weight:800;font-size:34px;line-height:.9;color:var(--terracotta-600)">01</span>
        <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-900)">Çekirdek</span>
        <p style="font-size:13px;line-height:1.5;color:var(--ink-800);margin:0;flex:1">Tek kökenli, taze kavrulmuş. Her parti elle ayıklanır.</p><div style="height:2px;background:rgba(34,31,19,.12);border-radius:999px;overflow:hidden"><div data-fill style="height:100%;width:0;background:var(--terracotta-600)"></div></div>
      </div></div>
      <div data-card style="display:flex;flex-direction:column;gap:8px;transition:opacity 320ms var(--ease-out-soft),transform 320ms var(--ease-out-soft);opacity:0;transform:translateY(22px)"><div style="display:flex;flex-direction:column;gap:8px;background:var(--cream-50);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-card);flex:1">
        <span style="font-family:var(--font-display);font-weight:800;font-size:34px;line-height:.9;color:var(--terracotta-600)">02</span>
        <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-900)">Öğütme</span>
        <p style="font-size:13px;line-height:1.5;color:var(--ink-800);margin:0;flex:1">Siparişten hemen önce, taş değirmende ince öğütülür.</p><div style="height:2px;background:rgba(34,31,19,.12);border-radius:999px;overflow:hidden"><div data-fill style="height:100%;width:0;background:var(--terracotta-600)"></div></div>
      </div></div>
      <div data-card style="display:flex;flex-direction:column;gap:8px;transition:opacity 320ms var(--ease-out-soft),transform 320ms var(--ease-out-soft);opacity:0;transform:translateY(22px)"><div style="display:flex;flex-direction:column;gap:8px;background:var(--cream-50);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-card);flex:1">
