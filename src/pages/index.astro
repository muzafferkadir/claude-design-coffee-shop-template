      if (inner) { inner.style.padding = compact ? "12px 14px" : "18px"; inner.style.gap = compact ? "4px" : "8px"; }
      if (body) body.style.display = compact ? "none" : "block";
      if (num) num.style.fontSize = compact ? "22px" : "34px";
    });
    if (lead) lead.style.display = tight ? "none" : "block";
    if (copy) copy.style.gap = compact ? "14px" : "22px";
    var badge = copy && copy.children[1];
    if (badge) badge.style.display = tight ? "none" : "flex";
  }

  function paint(p) {
    var steps = [0.08, 0.30, 0.52, 0.74];
    cardEls.forEach(function (el, i) {
      var t = (reduced || isMobile) ? 1 : Math.min(1, Math.max(0, (p - steps[i]) / 0.1));
      if (el) { el.style.opacity = t; el.style.transform = "translateY(" + (1 - t) * 22 + "px)"; }
      var f = fillEls[i];
      if (f) {
        var span = (i < 3 ? steps[i + 1] : 1) - steps[i];
        var g = (reduced || isMobile) ? 1 : Math.min(1, Math.max(0, (p - steps[i]) / span));
        f.style.width = (g * 100).toFixed(1) + "%";
      }
    });
    if (bar) bar.style.width = (p * 100).toFixed(2) + "%";
    if (hint) hint.style.opacity = p > 0.03 ? 0 : 1;
    if (percent) percent.textContent = String(Math.round(p * 100)).padStart(2, "0") + "%";
    tickEls.forEach(function (el, i) {
      if (!el) return;
      var reached = p >= stages[i][0];
      var isCur = reached && (i === stages.length - 1 || p < stages[i + 1][0]);
      el.style.background = reached ? (isCur ? "var(--terracotta-600)" : "var(--mustard-500)") : "rgba(34,31,19,.18)";
      el.style.width = isCur ? "34px" : reached ? "24px" : "16px";
    });
    if (stageLabel) {
      var label = stages[0][1];
      for (var s = 0; s < stages.length; s++) if (p >= stages[s][0]) label = stages[s][1];
      if (stageLabel.textContent !== label) stageLabel.textContent = label;
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onResize);
  window.addEventListener("load", onResize);
  if (typeof ResizeObserver !== "undefined") {
    var ro = new ResizeObserver(function () { onResize(); });
    ro.observe(document.documentElement);
    if (stage) ro.observe(stage);
  }
  [0, 60, 300].forEach(function (d) { window.setTimeout(onResize, d); });
  layout();

  if (video) {
    var reveal = function () { video.style.opacity = 1; };
    video.addEventListener("loadedmetadata", onScroll);
    video.addEventListener("seeked", reveal, { once: true });
    video.addEventListener("loadeddata", function () { onScroll(); window.setTimeout(reveal, 400); }, { once: true });
    video.addEventListener("error", reveal, { once: true });
    window.setTimeout(reveal, 2500);
  }
  onScroll();
})();
</script>
</body>
</html>
