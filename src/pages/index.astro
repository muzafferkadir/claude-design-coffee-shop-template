    <span data-stagelabel style="font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-800);background:var(--cream-50);padding:6px 10px;border-radius:999px;box-shadow:var(--shadow-card);white-space:nowrap">Cezve ısınıyor</span>
    <div style="display:flex;flex-direction:column;gap:7px;align-items:flex-end">
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
      <span data-tick style="width:16px;height:2px;background:rgba(34,31,19,.18);border-radius:999px;transition:width 200ms var(--ease-out-soft),background-color 200ms var(--ease-out-soft)"></span>
