      column.style.gap = m ? "16px" : "24px";
      column.style.paddingLeft = m ? "20px" : "clamp(20px,5vw,64px)";
      column.style.paddingRight = m ? "20px" : "clamp(20px,5vw,64px)";
      column.style.paddingBottom = m ? "26px" : "46px";
    }
    if (copy) copy.style.maxWidth = m ? "none" : "min(46vw,560px)";
    if (cards) {
      cards.style.gridTemplateColumns = m ? (window.innerHeight >= 720 ? "repeat(2,1fr)" : "repeat(4,1fr)") : "repeat(auto-fit,minmax(190px,1fr))";
      cards.style.gap = m ? "10px" : "16px";
      cards.style.marginTop = m ? "auto" : "0";
    }
    if (copy) { copy.style.overflow = m ? "hidden" : ""; copy.style.flex = m ? "1 1 auto" : ""; copy.style.minHeight = "0"; }
    if (title) {
      title.style.fontSize = m ? "clamp(30px,8.4vw,46px)" : "clamp(38px,min(5.6vw,8.4vh),82px)";
      title.style.maxWidth = m ? "14ch" : "11ch";
    }
    if (ctaRow) {
      ctaRow.style.gap = m ? "10px" : "16px";
      ctaRow.style.flexWrap = m ? "nowrap" : "wrap";
      $$("a,button", ctaRow).forEach(function (b) {
        b.style.padding = m ? "13px 15px" : "";
        b.style.fontSize = m ? "11px" : "";
        b.style.flex = m ? "1 1 0" : "";
