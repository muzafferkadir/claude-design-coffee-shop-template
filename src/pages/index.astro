        <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-900)">Demleme</span>
        <p style="font-size:13px;line-height:1.5;color:var(--ink-800);margin:0;flex:1">Közde, düşük ateşte, köpüğü kaçırmadan.</p><div style="height:2px;background:rgba(34,31,19,.12);border-radius:999px;overflow:hidden"><div data-fill style="height:100%;width:0;background:var(--terracotta-600)"></div></div>
      </div></div>
      <div data-card style="display:flex;flex-direction:column;gap:8px;transition:opacity 320ms var(--ease-out-soft),transform 320ms var(--ease-out-soft);opacity:0;transform:translateY(22px)"><div style="display:flex;flex-direction:column;gap:8px;background:var(--cream-50);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-card);flex:1">
        <span style="font-family:var(--font-display);font-weight:800;font-size:34px;line-height:.9;color:var(--terracotta-600)">04</span>
        <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-900)">Servis</span>
        <p style="font-size:13px;line-height:1.5;color:var(--ink-800);margin:0;flex:1">Bol köpüklü, yanında bir bardak su ve lokumla.</p><div style="height:2px;background:rgba(34,31,19,.12);border-radius:999px;overflow:hidden"><div data-fill style="height:100%;width:0;background:var(--terracotta-600)"></div></div>
      </div></div>
    </div>
  </div>
